      "kernel_id": "[kernel_boundary_id]",
      "kernel_boundary": "[deterministic or portable boundary description]",
      "pure_function_expected": "mixed",
      "required_fields": [
        {
          "name": "[field_name]",
          "type": "[type]",
          "description": "[description]",
          "units": "[unit or enum]"
        }
      ],
      "optional_fields": [],
